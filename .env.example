# Copie para .env (cp .env.example .env) e preencha a chave SECRETA. NUNCA versione o .env.
# Chaves secretas ficam SOMENTE no backend (Render), nunca nos apps.

# Supabase
SUPABASE_URL=https://nimdswolwleqvihvuqtt.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5pbWRzd29sd2xlcXZpaHZ1cXR0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxNjA3ODUsImV4cCI6MjEwNzczNjc4NX0.yQJ4RwnPeao5Dfka-QDO4Zj0Gto4KJWSLoXzi8nhIrA
# Supabase > Project Settings > API Keys > service_role (SECRETA)
SUPABASE_SERVICE_ROLE_KEY=
# Deixe vazio (projetos novos validam o login por chaves públicas JWKS).
# Só preencha com o "JWT Secret" legado se o login retornar 401.
SUPABASE_JWT_SECRET=

# Provedor de IA (troque sem mexer no app: AI_PROVIDER=mock | anthropic)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Limites de custo por aluno (minutos de conversa por dia)
DAILY_CONVERSATION_MINUTES_STUDENT=15
DAILY_CONVERSATION_MINUTES_KIDS=5

# Monitoramento
SENTRY_DSN=

PORT=8080
