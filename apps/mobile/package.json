{
  "name": "@app/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:kids": "APP_VARIANT=kids expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests src",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@app/api-client": "workspace:*",
    "@app/contracts": "workspace:*",
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.6",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.14",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.8"
  }
