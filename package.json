{
  "name": "app-ingles-ia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:test": "bash scripts/db-test.sh",
    "verify": "pnpm check:migrations && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "~19.1.8",
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  }
}
